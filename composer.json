{
    "name": "abdelhamiderrahmouni/laravel-settings",
    "description": "Production ready, super simple settings management for your laravel app.",
    "keywords": ["laravel", "settings", "configuration"],
    "type": "library",
    "require": {
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "php": "^8.2|^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^4.0",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.3",
        "larastan/larastan": "^3.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Settings\\": "src/",
            "Settings\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Settings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint",
        "rector": "vendor/bin/rector",
        "check": "composer test && composer analyse && composer rector && composer lint"
    },
    "authors": [
        {
            "name": "Abdelhamid Errahmouni",
            "email": "abdelhamid.errahmouni@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Settings\\SettingsServiceProvider"
            ],
            "aliases": {
                "Settings": "Settings\\Facades\\Settings"
            }
        }
    }
}
